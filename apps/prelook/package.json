{
  "name": "@extensions/prelook",
  "description": "悬停链接即预览，不必再点开",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:zen": "wxt -b firefox",
