{
  "name": "extensions",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:prelook": "pnpm -F @extensions/prelook dev",
    "dev:prelook:firefox": "pnpm -F @extensions/prelook dev:firefox",
    "build:prelook": "pnpm -F @extensions/prelook build",
    "build:prelook:firefox": "pnpm -F @extensions/prelook build:firefox",
    "zip:prelook": "pnpm -F @extensions/prelook zip",
    "zip:prelook:firefox": "pnpm -F @extensions/prelook zip:firefox",
    "compile:prelook": "pnpm -F @extensions/prelook compile",
    "landing:prelook": "pnpm -F @extensions/prelook-landing dev",
    "compile": "pnpm -r --if-present compile",
    "build": "pnpm -r --if-present build",
    "release:prelook": "pnpm -F @extensions/prelook release"
  },
  "devDependencies": {
    "@release-it/bumper": "^8.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "release-it": "^21.0.3"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": false
    }
  }
}